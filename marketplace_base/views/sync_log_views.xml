<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketplace_sync_log_list" model="ir.ui.view">
        <field name="name">marketplace.sync.log.list</field>
        <field name="model">marketplace.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Log" create="false" edit="false"
                  decoration-danger="state == 'error'" decoration-muted="state == 'retried'">
                <field name="create_date"/>
                <field name="channel"/>
                <field name="instance_name"/>
                <field name="operation"/>
                <field name="reference"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state == 'error'"
                       decoration-warning="state == 'retried'"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_marketplace_sync_log_form" model="ir.ui.view">
        <field name="name">marketplace.sync.log.form</field>
        <field name="model">marketplace.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log" create="false" edit="false">
                <header>
                    <button name="action_retry" string="Reintentar" type="object"
                            class="oe_highlight" invisible="state != 'error'"
                            confirm="¿Reprocesar este evento con el payload guardado?"/>
                    <button name="action_open_record" string="Ver Documento" type="object"
                            invisible="not res_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="channel"/>
                            <field name="instance_name"/>
                            <field name="operation"/>
                        </group>
                        <group>
                            <field name="reference"/>
                            <field name="state"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <group string="Detalle">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="Payload">
                        <field name="payload" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_marketplace_sync_log_search" model="ir.ui.view">
        <field name="name">marketplace.sync.log.search</field>
        <field name="model">marketplace.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="instance_name"/>
                <filter string="Errores" name="errors" domain="[('state', '=', 'error')]"/>
                <filter string="MercadoLibre" name="meli" domain="[('channel', '=', 'meli')]"/>
                <filter string="TiendaNube" name="tn" domain="[('channel', '=', 'tiendanube')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Canal" name="group_channel" context="{'group_by': 'channel'}"/>
                    <filter string="Operación" name="group_operation" context="{'group_by': 'operation'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_marketplace_sync_log" model="ir.actions.act_window">
        <field name="name">Log de Sincronización</field>
        <field name="res_model">marketplace.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_errors': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin eventos registrados todavía. Aquí aparecerán los webhooks,
                sincronizaciones y errores de los conectores de marketplaces.
            </p>
        </field>
    </record>

    <menuitem id="menu_marketplace_root" name="Marketplaces" sequence="56"
              web_icon="marketplace_base,static/description/icon.png"/>
    <menuitem id="menu_marketplace_sync_log"
              name="Log de Sincronización"
              parent="menu_marketplace_root"
              action="action_marketplace_sync_log"
              sequence="10"/>
</odoo>
