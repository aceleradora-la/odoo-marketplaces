<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tn_stock_picking_form" model="ir.ui.view">
        <field name="name">tn.stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tn_notify_fulfillment" string="Notificar Envío a TN"
                        type="object"
                        invisible="state != 'done' or not sale_id"/>
            </xpath>
        </field>
    </record>
</odoo>
