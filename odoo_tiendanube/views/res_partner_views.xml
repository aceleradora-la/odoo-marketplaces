<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tn_res_partner_form" model="ir.ui.view">
        <field name="name">tn.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="TiendaNube" name="tiendanube" invisible="not tn_customer_id">
                    <group>
                        <field name="tn_customer_id" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
