<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tn_res_partner_form" model="ir.ui.view">
        <field name="name">tn.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="TiendaNube" invisible="not tn_customer_id">
                    <field name="tn_customer_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
