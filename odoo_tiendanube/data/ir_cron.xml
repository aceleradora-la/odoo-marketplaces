<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sync price and stock to TN every hour -->
        <record id="ir_cron_tn_sync_price_stock" model="ir.cron">
            <field name="name">TiendaNube: Sync Price and Stock</field>
            <field name="model_id" ref="model_tn_product"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_price_stock()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Fallback order polling — disabled by default. Enable only if webhooks are not configured. -->
        <record id="ir_cron_tn_sync_orders" model="ir.cron">
            <field name="name">TiendaNube: Sync Orders (fallback)</field>
            <field name="model_id" ref="model_tn_instance"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_orders()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
