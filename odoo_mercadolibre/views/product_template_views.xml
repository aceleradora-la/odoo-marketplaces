<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_meli" model="ir.ui.view">
        <field name="name">product.template.form.inherit.meli</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="MercadoLibre">
                    <group>
                        <field name="meli_category_id" options="{'no_create': True}"/>
                    </group>
                    <div invisible="not meli_category_id">
                        <h3>MercadoLibre Attributes (Required)</h3>
                        <field name="meli_attribute_value_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="meli_attribute_id" domain="[('category_id', '=', parent.meli_category_id)]" options="{'no_create': True}"/>
                                <field name="is_required" readonly="1" force_save="1"/>
                                <field name="value"/>
                            </list>
                        </field>
                    </div>
                    <div>
                        <h3>MercadoLibre Images</h3>
                        <field name="meli_image_ids" nolabel="1" context="{'default_product_tmpl_id': id}">
                            <kanban>
                                <field name="id"/>
                                <field name="name"/>
                                <field name="image_1920"/>
                                <templates>
                                    <t t-name="card">
                                        <div class="oe_kanban_global_click" style="width: 100px;">
                                            <div class="o_kanban_image">
                                                <field name="image_1920" widget="image" options="{'size': [90, 90]}"/>
                                            </div>
                                            <div class="o_kanban_details">
                                                <field name="name"/>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </div>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
