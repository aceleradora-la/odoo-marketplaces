<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_meli" model="ir.ui.view">
        <field name="name">product.template.form.inherit.meli</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="MercadoLibre">
                    <group>
                        <field name="meli_category_id" options="{'no_create': True}"/>
                    </group>
                    <group string="MercadoLibre Attributes (Required)" invisible="not meli_category_id">
                        <field name="meli_attribute_value_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="meli_attribute_id" domain="[('category_id', '=', parent.meli_category_id)]" options="{'no_create': True}"/>
                                <field name="is_required" readonly="1" force_save="1"/>
                                <field name="value"/>
                            </list>
                        </field>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
