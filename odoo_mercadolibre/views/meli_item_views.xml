<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meli_item_form" model="ir.ui.view">
        <field name="name">meli.item.form</field>
        <field name="model">meli.item</field>
        <field name="arch" type="xml">
            <form string="MercadoLibre Publication">
                <header>
                    <button name="action_publish" string="Publish to ML" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_pause" string="Pause" type="object" invisible="status != 'active'"/>
                    <button name="action_activate" string="Re-activate" type="object" invisible="status != 'paused'"/>
                    <button name="action_back_to_draft" string="Reset to Draft" type="object" invisible="status != 'error'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,paused,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Publication Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="instance_id"/>
                            <field name="meli_category_id"/>
                            <field name="listing_type"/>
                        </group>
                        <group>
                            <field name="meli_id"/>
                            <field name="price"/>
                            <field name="available_quantity"/>
                            <field name="permalink" widget="url"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_meli_item_tree" model="ir.ui.view">
        <field name="name">meli.item.tree</field>
        <field name="model">meli.item</field>
        <field name="arch" type="xml">
            <list string="MercadoLibre Publications">
                <field name="name"/>
                <field name="product_id"/>
                <field name="instance_id"/>
                <field name="meli_id"/>
                <field name="price"/>
                <field name="available_quantity"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-info="status == 'draft'" decoration-danger="status == 'closed'" decoration-warning="status == 'paused'"/>
            </list>
        </field>
    </record>

    <record id="action_meli_item" model="ir.actions.act_window">
        <field name="name">Publications</field>
        <field name="res_model">meli.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="meli_menu_publications"
              name="Publications"
              parent="meli_menu_root"
              sequence="20"/>

    <menuitem id="menu_meli_item_action"
              name="Items"
              parent="meli_menu_publications"
              action="action_meli_item"
              sequence="10"/>
</odoo>
