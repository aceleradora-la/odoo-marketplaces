<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meli_item_form" model="ir.ui.view">
        <field name="name">meli.item.form</field>
        <field name="model">meli.item</field>
        <field name="arch" type="xml">
            <form string="MercadoLibre Publication">
                <header>
                    <button name="action_publish" string="Publish to ML" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_check_status" string="Check ML Status" type="object" invisible="status == 'draft'"/>
                    <button name="action_pause" string="Pause" type="object" invisible="status != 'active'"/>
                    <button name="action_activate" string="Re-activate" type="object" invisible="status != 'paused'"/>
                    <button name="action_close" string="Close Publication" type="object" invisible="status in ['draft', 'closed']" confirm="Esto cerrará la publicación en ML. ¿Continuar?"/>
                    <button name="action_back_to_draft" string="Reset to Draft" type="object" invisible="status not in ['error', 'closed', 'paused']"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,paused,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Publication Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="instance_id"/>
                            <field name="meli_category_id"/>
                            <field name="listing_type"/>
                        </group>
                        <group>
                            <field name="meli_id"/>
                            <field name="price"/>
                            <field name="available_quantity"/>
                            <field name="permalink" widget="url"/>
                        </group>
                        <group string="Publicación">
                            <field name="condition"/>
                            <field name="shipping_mode"/>
                            <field name="free_shipping"/>
                            <field name="local_pick_up"/>
                        </group>
                        <group string="Logística ML" invisible="not meli_id">
                            <field name="is_full_flex"/>
                            <field name="user_product_id" invisible="not is_full_flex"/>
                        </group>
                    </group>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_meli_item_tree" model="ir.ui.view">
        <field name="name">meli.item.tree</field>
        <field name="model">meli.item</field>
        <field name="arch" type="xml">
            <list string="MercadoLibre Publications">
                <field name="name"/>
                <field name="product_id"/>
                <field name="instance_id"/>
                <field name="meli_id"/>
                <field name="price"/>
                <field name="available_quantity"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-info="status == 'draft'" decoration-danger="status == 'closed'" decoration-warning="status == 'paused'"/>
            </list>
        </field>
    </record>

    <record id="action_meli_item" model="ir.actions.act_window">
        <field name="name">Publications</field>
        <field name="res_model">meli.item</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_meli_item_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera publicación de MercadoLibre aquí.
            </p>
        </field>
    </record>

    <menuitem id="meli_menu_publications"
              name="Publications"
              parent="meli_menu_root"
              sequence="20"/>

    <menuitem id="menu_meli_item_action"
              name="Items"
              parent="meli_menu_publications"
              action="action_meli_item"
              sequence="10"/>
</odoo>
