<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meli_instance_form" model="ir.ui.view">
        <field name="name">meli.instance.form</field>
        <field name="model">meli.instance</field>
        <field name="arch" type="xml">
            <form string="MercadoLibre Instance">
                <header>
                    <button name="action_get_authorization_url" string="1. Get Auth URL" type="object" class="oe_highlight" invisible="state == 'authenticated'"/>
                    <button name="action_get_token" string="2. Fetch Token" type="object" class="oe_highlight" invisible="state == 'authenticated'"/>
                    <button name="action_refresh_token" string="Refresh Token" type="object" invisible="state == 'draft'"/>
                    <button name="action_sync_root_categories" string="Sync Categories" type="object" invisible="state != 'authenticated'"/>
                    <button name="action_sync_items" string="Sync Items" type="object" invisible="state != 'authenticated'"/>
                    <button name="action_sync_orders" string="Sync Orders (fallback)" type="object" invisible="state != 'authenticated'"/>
                    <button name="action_fetch_payment_methods" string="Importar Métodos de Pago" type="object" invisible="state != 'authenticated'"
                            help="Consulta los métodos de pago disponibles en ML para este site y los agrega a la tabla de mapeos."/>
                    <button name="action_reset_connection" string="Reset Connection" type="object" invisible="state == 'draft'" confirm="This will clear current tokens. Are you sure?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,authenticated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="E.g. My Main ML Account"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Credentials">
                            <field name="site_id"/>
                            <field name="app_id"/>
                            <field name="secret_key" password="True"/>
                            <field name="redirect_uri"/>
                            <field name="seller_id"/>
                            <field name="currency_ml"/>
                        </group>
                        <group string="Configuration">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="pricelist_id"/>
                            <field name="stock_location_ids" widget="many2many_tags"/>
                            <field name="warehouse_full_id"
                                   help="Opcional. Almacén que representa el stock en centros ML FULL. Si se configura, los pedidos FULL se despachan desde aquí y se validan automáticamente."/>
                        </group>
                        <group string="Comisiones y Costos">
                            <field name="create_fee_bill"/>
                            <field name="fee_partner_id" invisible="not create_fee_bill" required="create_fee_bill"/>
                            <field name="fee_product_id" invisible="not create_fee_bill"/>
                            <field name="shipping_cost_product_id" invisible="not create_fee_bill"/>
                        </group>
                        <group string="Authentication Status">
                            <field name="authorization_code" invisible="state == 'authenticated'"/>
                            <field name="access_token" password="True"/>
                            <field name="refresh_token" password="True"/>
                            <field name="token_expiration"/>
                        </group>
                        <group string="Notificaciones (Webhooks)" colspan="2">
                            <field name="webhook_url" readonly="1"
                                   help="Copiá esta URL en MercadoLibre Developers → Tu App → Notificaciones → URL de notificaciones. Activá los tópicos 'orders_v2' y 'shipments'."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Métodos de Pago" name="payment_methods">
                            <p class="text-muted">
                                Usá el botón <strong>"Importar Métodos de Pago"</strong> para cargar automáticamente los métodos disponibles en MercadoLibre para este site.
                                Luego asigná el diario contable correspondiente a cada uno.
                                Si no hay mapeo, se usará el primer diario banco/caja disponible.
                            </p>
                            <field name="payment_method_ids">
                                <list editable="bottom">
                                    <field name="payment_method_id" placeholder="ej: visa"/>
                                    <field name="payment_type_id" placeholder="ej: credit_card"/>
                                    <field name="description" placeholder="ej: Tarjeta Visa"/>
                                    <field name="journal_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_meli_instance_tree" model="ir.ui.view">
        <field name="name">meli.instance.tree</field>
        <field name="model">meli.instance</field>
        <field name="arch" type="xml">
            <list string="MercadoLibre Instances">
                <field name="name"/>
                <field name="app_id"/>
                <field name="state" widget="badge" decoration-success="state == 'authenticated'" decoration-info="state == 'draft'" decoration-danger="state == 'error'"/>
                <field name="token_expiration"/>
            </list>
        </field>
    </record>

    <record id="action_meli_instance" model="ir.actions.act_window">
        <field name="name">MercadoLibre Instances</field>
        <field name="res_model">meli.instance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_meli_instances_action"
              name="Accounts"
              parent="meli_menu_instances"
              action="action_meli_instance"
              sequence="10"/>
</odoo>
